-- PawHome database
-- Import this in phpMyAdmin (Import tab) or run it in the MySQL console.

CREATE DATABASE IF NOT EXISTS pet_adoption;
USE pet_adoption;

DROP TABLE IF EXISTS applications;
DROP TABLE IF EXISTS pets;

-- PETS TABLE
CREATE TABLE pets (
    id          INT AUTO_INCREMENT PRIMARY KEY,
    name        VARCHAR(50)  NOT NULL,
    type        VARCHAR(20)  NOT NULL,
    breed       VARCHAR(50)  NOT NULL,
    age         VARCHAR(20)  NOT NULL,
    gender      VARCHAR(10)  NOT NULL,
    health      VARCHAR(50)  NOT NULL,
    image       VARCHAR(100) NOT NULL,
    description TEXT         NOT NULL,
    status      VARCHAR(20)  NOT NULL DEFAULT 'Available'
);

-- ADOPTION APPLICATIONS TABLE (saves form.php submissions)
CREATE TABLE applications (
    id          INT AUTO_INCREMENT PRIMARY KEY,
    pet_id      INT          NOT NULL,
    fullname    VARCHAR(100) NOT NULL,
    email       VARCHAR(100) NOT NULL,
    phone       VARCHAR(20)  NOT NULL,
    address     TEXT         NOT NULL,
    housing     VARCHAR(20)  NOT NULL,
    experience  VARCHAR(5)   NOT NULL,
    reason      TEXT         NOT NULL,
    status      VARCHAR(20)  NOT NULL DEFAULT 'Pending',
    created_at  TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (pet_id) REFERENCES pets(id) ON DELETE CASCADE
);

